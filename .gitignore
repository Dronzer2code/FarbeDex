# Model files (downloaded at runtime; never committed)
.models/
*.gguf
*.onnx
*.ort

# Signing (never committed)
*.keystore
*.jks
keystore.properties
credentials.json

# Env (this project has no .env; ignore defensively)
.env
.env*.local

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by `npx expo prebuild`; continuous native generation)
/android
/ios
*.apk
*.aab

# Android build outputs (in case /android is ever committed)
android/app/build/
android/build/
android/.gradle/
android/.cxx/
android/local.properties

# Metro / misc
.metro-health-check*
*.log
npm-debug.*
*.tsbuildinfo
coverage/

# OS / editors
.DS_Store
Thumbs.db
~$*
*.swp

# Reference screenshots MUST NOT be committed (CLAUDE.md → HARD RULES)
reference-screenshots/
